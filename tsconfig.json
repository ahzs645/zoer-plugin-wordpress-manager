{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@zoer/api-types": [
        "./packages/api-types/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "tools/parity",
    "tools/live-gate"
  ]
}
