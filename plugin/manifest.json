        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/runtime-action.js"
        },
        "requiredCapabilities": [
          "runtime-resources"
        ],
        "requiredRuntimes": [
          {
            "alias": "wordpress_site",
            "purpose": "Create a database and WP_CONTENT_DIR backup.",
