              "ddev"
            ],
            "operations": [
              "backup.create.v1"
            ]
          }
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "siteId": {
              "type": "string",
              "pattern": "^ddev-[a-z0-9-]+$"
