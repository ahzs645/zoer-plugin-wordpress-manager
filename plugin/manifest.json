      {
        "id": "backup.restore",
        "title": "Restore application backup",
        "description": "Verify the exact manifest and component digests, snapshot the current database, then replace the database and WP_CONTENT_DIR. Requires one-time Full access approval.",
        "effect": "destructive",
        "approval": "always",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/runtime-action.js"
        },
        "requiredCapabilities": [
          "runtime-resources"
        ],
        "requiredRuntimes": [
          {
            "alias": "wordpress_site",
            "purpose": "Restore an integrity-checked WordPress application backup.",
            "connectorIds": [
              "ddev"
            ],
            "operations": [
              "backup.restore.v1"
            ]
          }
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "siteId": {
              "type": "string",
              "pattern": "^ddev-[a-z0-9-]+$"
            },
            "backupId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}$"
            },
            "expectedManifestSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "siteId",
            "backupId",
            "expectedManifestSha256"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "ok",
            "summary"
          ]
        },
        "resourceLimits": {
          "timeoutMs": 900000,
          "maxMemoryMb": 128,
          "maxOutputBytes": 131072
        },
        "idempotent": false
      },
