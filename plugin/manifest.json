{
  "id": "wordpress-manager",
  "name": "WordPress Manager",
  "version": "0.5.9",
  "description": "Independent WordPress workspace with Hostinger temporary-domain setup, safe imports, backups, transfers, update review and cache tools.",
  "author": "Zoer contributors",
  "type": "integration",
  "integration": {
    "apiVersion": "1",
    "permissions": [
      "runtime:wordpress:read",
      "runtime:wordpress:lifecycle",
      "database:linked-register",
      "wordpress:wp-cli:read",
      "wordpress:snapshots",
      "wordpress:backups",
      "workspace:native",
      "workspace:wordpress"
    ],
    "workspace": {
      "title": "WordPress",
      "icon": "wordpress",
      "surfaceIds": [
        "sites-table",
        "health-table",
        "plugins-table",
        "themes-table",
        "users-table",
        "backups-table"
      ],
      "native": {
        "module": "native/index.js",
        "style": "native/style.css"
      }
    },
    "actions": [
      {
        "id": "sites.refresh",
        "title": "Refresh WordPress sites",
        "description": "Inspect DDEV WordPress sites and reconcile their credential-free MariaDB links into Zoer's database registry.",
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/sites.js"
        },
        "requiredCapabilities": [
          "runtime-resources"
        ],
        "requiredRuntimes": [
          {
            "alias": "wordpress_sites",
            "purpose": "List and inspect DDEV WordPress runtimes and register their linked database references.",
            "connectorIds": [
              "ddev"
            ],
            "operations": [
              "runtime.list.v1",
              "wordpress.overview.v1",
              "database.register-linked.v1"
            ]
          }
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rows": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "wordpress": {
                    "type": "string"
                  },
                  "updates": {
                    "type": "string"
                  },
                  "home": {
                    "type": "string"
                  },
                  "preview": {
                    "type": "string",
                    "pattern": "^ddev-[a-z0-9-]+$"
                  },
                  "admin": {
                    "type": "string",
                    "pattern": "^ddev-[a-z0-9-]+$"
                  },
                  "database": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "status",
                  "wordpress",
                  "updates",
                  "home",
                  "preview",
                  "admin",
                  "database"
                ]
              }
            }
          },
          "required": [
            "rows"
          ]
        },
        "resourceLimits": {
          "timeoutMs": 120000,
          "maxMemoryMb": 128,
          "maxOutputBytes": 524288
        },
        "idempotent": true
      },
      {
        "id": "site.start",
        "title": "Start site",
        "description": "Start one selected DDEV WordPress runtime.",
        "effect": "local_write",
        "approval": "when_configured",
        "execution": {
          "kind": "isolated-process",
          "handler": "worker/runtime-action.js"
        },
        "requiredCapabilities": [
          "runtime-resources"
        ],
        "requiredRuntimes": [
          {
            "alias": "wordpress_site",
            "purpose": "Start a selected DDEV site.",
            "connectorIds": [
              "ddev"
            ],
            "operations": [
              "runtime.start.v1"
            ]
          }
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "siteId": {
              "type": "string",
              "pattern": "^ddev-[a-z0-9-]+$"
            }
          },
          "required": [
            "siteId"
          ]
        },
        "outputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "ok",
            "summary"
          ]
        },
        "resourceLimits": {
          "timeoutMs": 120000,
          "maxMemoryMb": 128,
          "maxOutputBytes": 131072
        },
        "idempotent": true
      },
      {
